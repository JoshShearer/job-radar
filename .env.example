# Copy to .env and fill in. .env is gitignored; never commit real keys.

# Required for `job-radar analyze` (the LLM semantic-analysis stage).
# Everything else in the pipeline runs without it.
ANTHROPIC_API_KEY=sk-ant-...

# Model used for job analysis. Default: claude-opus-5
# Cheaper alternatives if you are running high job volume: claude-sonnet-5, claude-haiku-4-5
# JOB_RADAR_MODEL=claude-opus-5

# Reasoning effort for analysis calls: low | medium | high | xhigh | max
# JOB_RADAR_EFFORT=medium

# Override paths (optional)
# JOB_RADAR_DB=./data/job-radar.sqlite
# JOB_RADAR_PROFILE=./config/career-profile.yaml
# JOB_RADAR_SOURCES=./config/sources.yaml
# JOB_RADAR_REPORTS=./reports

# Contact string sent in the User-Agent header on outbound requests, so source
# operators can reach you. Polite, and some feeds ask for it.
# JOB_RADAR_CONTACT=you@example.com
