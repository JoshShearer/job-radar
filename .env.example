# Paid model access on model.provider: api (assess / tailor / prepare / evidence import).
ANTHROPIC_API_KEY=
# model.provider: claude-cli runs `claude -p` on your claude.ai subscription and is OFF
# unless this is 1. Setting it lets every model command spend subscription quota.
# Never set it in a /run-tickets lane or for `npm test`. See docs/adr/0004.
# JR_ALLOW_MODEL=1
# Optional: read-only Gmail (scope gmail.readonly). Nothing is ever sent.
JOB_RADAR_GMAIL_CLIENT_ID=
JOB_RADAR_GMAIL_CLIENT_SECRET=
JOB_RADAR_GMAIL_REFRESH_TOKEN=
# Optional: appended to the User-Agent so board operators can reach you.
JOB_RADAR_CONTACT=
# Optional: relocate everything (config/, data/, reports/, artifacts/).
# JR_HOME=
