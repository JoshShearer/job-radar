node_modules/
dist/
*.log

# Local database and any backups of it
data/
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm

# Generated reports
reports/

# Personal resume source + generated variants (never commit these)
resumes/*
!resumes/README.md
!resumes/.gitkeep

# Secrets
.env
.env.local
.env.*.local

# Editor / OS
.DS_Store
.vscode/
.idea/

# Generated application packages (personal material)
applications/

# Real contact details, work-authorization answers, links
config/personal.yaml
# Timestamped copies written before `autofill` saves a learned answer. Same
# personal data as the original, so the same rule applies.
config/personal.yaml.*.bak

# Persistent browser profile used by `autofill` (holds cookies/sessions)
.browser-profile/

# Master resume (real employment history)
config/resume.yaml
config/resume.yaml.*.bak

# Claude Code working notes: session handoffs, plans, last critique verdict.
# The commands themselves (.claude/commands/, .claude/linear.md) ARE committed.
.claude/scratch/*
!.claude/scratch/.gitkeep
.claude/last-critique.md
.worktree-meta.json

# /run-tickets orchestration state (scratch, not project content)
.planning/
