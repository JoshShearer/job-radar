node_modules/
dist/
*.log

# Local database, its backups, and generated output. Root-anchored: an
# unanchored `reports/` also ignored src/ui/reports/ and dropped it from a commit.
/data/
*.sqlite
*.sqlite-*
/reports/
/artifacts/

# Secrets
.env
.env.local
.env.*.local

# Candidate facts: every claim about you, and form-filling facts.
# The search strategy, preferences and policy under config/ ARE committed.
config/candidate/evidence.yaml
config/candidate/personal.yaml
config/candidate/*.bak

# Persistent browser profile used by `jr fill` (holds cookies/sessions)
/.browser-profile/

# Left on disk by the previous version (v1-final) in an existing checkout.
# Personal data: never commit it. See MIGRATING.md.
/legacy-v1/
/applications/
/resumes/*
config/resume.yaml
config/resume.yaml.*.bak
config/personal.yaml
config/personal.yaml.*.bak

# Editor / OS
.DS_Store
.vscode/
.idea/

# Claude Code working notes and /run-tickets state (machine-local)
.claude/scratch/*
!.claude/scratch/.gitkeep
.claude/last-critique.md
.worktree-meta.json
.planning/
.claude/pipeline-state*.json
