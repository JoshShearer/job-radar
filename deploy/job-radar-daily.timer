[Unit]
Description=Run the Job Radar daily pass each morning
Documentation=https://github.com/JoshShearer/job-radar

[Timer]
# Early enough that the briefing is waiting, late enough that boards have
# posted the previous day's roles.
OnCalendar=*-*-* 07:15:00
# Laptops are asleep at 07:15. Without this the run is simply skipped and the
# index quietly goes stale - which is the failure this issue exists to fix.
Persistent=true
# Every board is hit at the same minute by every user otherwise.
RandomizedDelaySec=20min

[Install]
WantedBy=timers.target
