{
  "name": "job-radar",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Job Radar rebuilt: append-only facts, memoized derivations, evidence-checked materials, one model gateway.",
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "jr": "src/ui/cli.ts"
  },
  "scripts": {
    "cli": "tsx src/ui/cli.ts",
    "daily": "tsx src/ui/cli.ts daily",
    "serve": "tsx src/ui/cli.ts serve",
    "test": "vitest run",
    "test:unit": "vitest run --exclude tests/browser.refusals.test.ts",
    "test:browser": "vitest run tests/browser.refusals.test.ts",
    "typecheck": "tsc --noEmit",
    "gen:port": "tsx scripts/gen-store-port.ts",
    "gen:examples": "tsx scripts/gen-example-config.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.134.0",
    "better-sqlite3": "^13.0.3",
    "commander": "^15.0.0",
    "playwright": "^1.64.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
